{
  "info": {
    "name": "Campus Carpool Finder API",
    "description": "Complete REST API collection for Campus Carpool Finder MVP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rohan Sharma\",\n  \"email\": \"rohan@college.edu\",\n  \"password\": \"password123\",\n  \"phone\": \"9876543210\",\n  \"collegeId\": \"22BCSE104\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"rohan@college.edu\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "Auth - Current User Profile (Me)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        }
      }
    },
    {
      "name": "User - Update Vehicle",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"make\": \"Hyundai\",\n  \"model\": \"i20\",\n  \"licensePlate\": \"DL 04 AB 9876\",\n  \"color\": \"White\",\n  \"capacity\": 4\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users/vehicle",
          "host": ["{{baseUrl}}"],
          "path": ["users", "vehicle"]
        }
      }
    },
    {
      "name": "Rides - Post Ride",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"Metro Station Gate 3\",\n  \"destination\": \"Campus Main Gate\",\n  \"departureDate\": \"2026-11-25\",\n  \"departureTime\": \"08:30 AM\",\n  \"totalSeats\": 3,\n  \"pricePerSeat\": 50,\n  \"notes\": \"AC is on, leaving on time\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/rides",
          "host": ["{{baseUrl}}"],
          "path": ["rides"]
        }
      }
    },
    {
      "name": "Rides - Search Rides",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/rides?origin=Metro&destination=Campus",
          "host": ["{{baseUrl}}"],
          "path": ["rides"],
          "query": [
            { "key": "origin", "value": "Metro" },
            { "key": "destination", "value": "Campus" }
          ]
        }
      }
    },
    {
      "name": "Requests - Request to Join",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rideId\": \"<RIDE_ID_HERE>\",\n  \"seatsRequested\": 1,\n  \"message\": \"I have a backpack, waiting at gate\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/requests",
          "host": ["{{baseUrl}}"],
          "path": ["requests"]
        }
      }
    },
    {
      "name": "Requests - Respond to Request (Accept/Reject)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"accepted\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/requests/<REQUEST_ID_HERE>/status",
          "host": ["{{baseUrl}}"],
          "path": ["requests", "<REQUEST_ID_HERE>", "status"]
        }
      }
    },
    {
      "name": "Notifications - Get Notifications",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/notifications",
          "host": ["{{baseUrl}}"],
          "path": ["notifications"]
        }
      }
    },
    {
      "name": "Ratings - Submit Rating",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rideId\": \"<RIDE_ID_HERE>\",\n  \"toUserId\": \"<USER_ID_HERE>\",\n  \"rating\": 5,\n  \"review\": \"Great co-passenger, punctual and friendly!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ratings",
          "host": ["{{baseUrl}}"],
          "path": ["ratings"]
        }
      }
    },
    {
      "name": "Admin - Get Stats",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/stats",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "stats"]
        }
      }
    }
  ]
}
